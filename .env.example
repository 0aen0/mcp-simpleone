# SimpleOne (ESM) URL
SIMPLEONE_URL=https://your-instance.simpleone.ru

# Аутентификация (выберите ОДИН вариант).
# Приоритет: API-ключ > Basic Auth. Поэтому для входа по логину/паролю
# строка SIMPLEONE_API_KEY ниже должна оставаться закомментированной.

# Вариант 1 (по умолчанию): Basic Auth — логин и пароль
SIMPLEONE_BASIC_USER=your-username
SIMPLEONE_BASIC_PASSWORD=your-password

# Вариант 2: токен SimpleOne — auth_key из POST /rest/v1/auth/login,
# отправляется заголовком Authorization: Bearer (не X-API-Key).
# Раскомментируйте и закомментируйте Basic Auth выше.
# SIMPLEONE_API_KEY=your-auth-token-here

# Опционально: таймаут запросов (мс)
# SIMPLEONE_TIMEOUT=30000

# Опционально: отключить подтверждения для create/update/delete (true/false)
# Предостережение: Использовать только в автоматизации/CI!
# SIMPLEONE_AUTO_CONFIRM=false

# Опционально: порт для HTTP/SSE транспорта
# MCP_PORT=3000

# Опционально: уровень логирования (trace, debug, info, warn, error)
# По умолчанию: info
# LOG_LEVEL=debug

# Опционально: вывод логов (stdout, file, both)
# По умолчанию: stdout
# LOG_OUTPUT=both

# Опционально: путь к файлу логов (используется при LOG_OUTPUT=file или both)
# По умолчанию: ./logs/mcp-simpleone.log
# LOG_FILE=./logs/mcp-simpleone.log

# Для разработки с самоподписанным сертификатом
NODE_TLS_REJECT_UNAUTHORIZED=0
